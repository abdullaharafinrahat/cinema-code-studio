{
  "name": "cinema-code-studio-remotion",
  "version": "5.0.0",
  "private": true,
  "description": "Recipe-Driven Commercial Mixed-Media & Deterministic Post-Production Studio powered by Remotion 4.0.538 + React 19",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render MasterSequence ../out/picture.mp4 --codec=h264 --crf=17 --pixel-format=yuv420p",
    "render:alpha": "remotion render MasterSequence ../out/overlay-alpha.mov --codec=prores --prores-profile=4444 --image-format=png --pixel-format=yuva444p10le",
    "typecheck": "tsc --noEmit",
    "draft": "remotion render MasterSequence ../out/draft.mp4 --codec=h264 --crf=30 --scale=0.4 --pixel-format=yuv420p --concurrency=100%"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "@remotion/motion-blur": "4.0.538",
    "@remotion/paths": "4.0.538",
    "@remotion/shapes": "4.0.538",
    "@remotion/transitions": "4.0.538",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "typescript": "^5.8.2"
  }
}
