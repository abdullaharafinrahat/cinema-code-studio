{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinema-code-studio.local/schemas/creative_brief.schema.json",
  "title": "CinemaCodeStudioCreativeBrief",
  "description": "Gate 1 Creative Director lock: emotional arc, visual world, mixed-media asset strategy, typography pair, and anti-cliche constraints.",
  "type": "object",
  "required": [
    "projectTitle",
    "format",
    "emotionalArc",
    "visualWorld",
    "kuleshovStrategy",
    "typography",
    "antiGoals"
  ],
  "properties": {
    "projectTitle": { "type": "string", "minLength": 2 },
    "targetAudience": { "type": "string" },
    "format": {
      "type": "object",
      "required": ["width", "height", "fps", "targetDurationSec"],
      "properties": {
        "width": { "type": "integer", "minimum": 320, "maximum": 7680 },
        "height": { "type": "integer", "minimum": 320, "maximum": 7680 },
        "fps": { "type": "integer", "enum": [24, 25, 30, 60] },
        "targetDurationSec": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "emotionalArc": {
      "type": "object",
      "required": ["fromState", "tensionState", "toState", "coreThesis"],
      "properties": {
        "fromState": { "type": "string" },
        "tensionState": { "type": "string" },
        "toState": { "type": "string" },
        "coreThesis": { "type": "string" }
      }
    },
    "visualWorld": {
      "type": "string",
      "enum": [
        "COMMERCIAL_MIXED_MEDIA",
        "SWISS_EDITORIAL_DARK",
        "TACTILE_PAPER_CRAFT",
        "PRECISION_CINEMA_LAB",
        "KINETIC_PULSE_SOCIAL",
        "CUSTOM_AUTEUR"
      ]
    },
    "editGrammar": {
      "type": "object",
      "description": "Gate 1.5 Script Shape & Edit Grammar. Extracts THIS script's unique narrative arc and generates a per-script shot vocabulary, camera-move sequence, transition vocabulary, and pacing signature. This is what makes every edit uniquely identifiable.",
      "required": ["arcName", "scriptSignatureHash"],
      "properties": {
        "arcName": {
          "type": "string",
          "description": "A human-readable name for this script's narrative shape (e.g., 'Contrarian Reveal', 'Teardown-Rebuild', 'Hero-Villain-Resolution').",
          "minLength": 3
        },
        "scriptSignatureHash": {
          "type": "string",
          "description": "Deterministic hash or short phrase that uniquely identifies this edit's grammar.",
          "minLength": 5
        },
        "beatCount": { "type": "integer", "minimum": 4, "maximum": 12 },
        "beatSequence": {
          "type": "array",
          "minItems": 4,
          "maxItems": 12,
          "description": "Custom beat IDs for THIS script — NOT the universal skeleton."
        },
        "shotVocabulary": {
          "type": "array",
          "minItems": 5,
          "maxItems": 12
        },
        "cameraMoveVocabulary": {
          "type": "array",
          "minItems": 4,
          "maxItems": 10
        },
        "transitionVocabulary": {
          "type": "array",
          "minItems": 3,
          "maxItems": 8
        },
        "pacingSignature": {
          "type": "object",
          "required": ["startPace", "accelerationPoint", "peakPace", "breathHoldLocation", "endingPace"]
        },
        "forbiddenRepetitions": {
          "type": "array",
          "description": "Explicit patterns that this script must NOT repeat."
        }
      }
    },
    "assetStrategy": {
      "type": "object",
      "description": "Mixed-media sourcing plan: prefer verified real photography and authentic brand SVGs over naked CSS/3D shapes.",
      "properties": {
        "verifiedBrandIcons": { "type": "array", "items": { "type": "string" } },
        "verifiedWebPhotos": { "type": "array", "items": { "type": "string" } },
        "bespokeStudioPlates": { "type": "array", "items": { "type": "string" } }
      }
    },
    "kuleshovStrategy": {
      "type": "string",
      "description": "How visuals provide concrete evidence, tension, or contrast rather than duplicating spoken nouns."
    },
    "typography": {
      "type": "object",
      "required": ["displayFont", "utilityFont", "tabularNumerals"],
      "properties": {
        "displayFont": { "type": "string" },
        "utilityFont": { "type": "string" },
        "tabularNumerals": { "type": "boolean", "const": true }
      }
    },
    "antiGoals": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string" },
      "description": "Explicit visual tropes, stock cliches, or motion gimmicks forbidden in this production."
    }
  }
}
